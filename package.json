{
  "name": "yzu-cluster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "bash scripts/tree-role.sh",
    "test": "node --test drive/src/v2/*.test.js drive/tests/*.test.mjs",
    "test:e2e": "mkdir -p .tmp-pw && TMPDIR=$PWD/.tmp-pw playwright test",
    "test:mount": "mkdir -p .tmp-pw && TMPDIR=$PWD/.tmp-pw playwright test e2e/app-mounts.spec.js",
    "test:python": "uvx pytest -q tests",
    "check:names": "node scripts/check-undefined-names.cjs $(find drive/src -name '*.js' -o -name '*.jsx' | grep -v '\\.test\\.js$')",
    "check:layout": "node scripts/check-layout-authority.mjs",
    "serve:candidate": "python3 scripts/serve_candidate.py",
    "test:candidate-release": "bash scripts/candidate-release-gate.sh",
    "desk:audit:deployed": "node scripts/audit_deployed_desk.mjs",
    "desk:capture": "bash scripts/capture_desk_screenshots.sh"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.10",
    "@vitejs/plugin-react": "^4.4.1",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
